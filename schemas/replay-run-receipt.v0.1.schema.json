{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "miskatonic.replay-run-receipt.v0.1",
  "title": "Miskatonic Replay Run Receipt Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "replay_mode",
    "arm",
    "paired_contract_digest",
    "experimental_unit_id",
    "problem_id",
    "problem_digest",
    "backend_id",
    "search_policy_kind",
    "search_policy_configuration_digest",
    "search_budget_digest",
    "random_seed",
    "corpus_context_digest",
    "candidate_id",
    "candidate_enabled",
    "started_at",
    "completed_at",
    "nodes_expanded",
    "nodes_evaluated",
    "branch_count",
    "solved",
    "wall_time_ms",
    "backend_calls",
    "search_run_ref",
    "search_run_digest",
    "execution_trace_refs",
    "execution_trace_digests",
    "evidence_origin",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "miskatonic.replay-run-receipt.v0.1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "replay_mode": {
      "type": "string",
      "enum": [
        "EXECUTED_HELD_OUT_REPLAY",
        "SYNTHETIC_REPLAY_FIXTURE"
      ]
    },
    "arm": {
      "type": "string",
      "enum": [
        "BASELINE",
        "ABSTRACTED"
      ]
    },
    "paired_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "experimental_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend_id": {
      "type": "string",
      "minLength": 1
    },
    "search_policy_kind": {
      "type": "string",
      "minLength": 1
    },
    "search_policy_configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "search_budget_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "random_seed": {
      "type": "integer"
    },
    "corpus_context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_enabled": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "nodes_expanded": {
      "type": "integer",
      "minimum": 0
    },
    "nodes_evaluated": {
      "type": "integer",
      "minimum": 0
    },
    "branch_count": {
      "type": "integer",
      "minimum": 0
    },
    "solved": {
      "type": "boolean"
    },
    "wall_time_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "backend_calls": {
      "type": "integer",
      "minimum": 0
    },
    "search_run_ref": {
      "type": "string",
      "minLength": 1
    },
    "search_run_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_trace_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_trace_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "search_execution_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_origin": {
      "type": "string",
      "enum": [
        "EXECUTED_SEARCH_RUN",
        "CERTIFIED_SEARCH_REPLAY",
        "SYNTHETIC_FIXTURE"
      ]
    },
    "authority": {
      "const": "NONE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_origin": {
            "const": "EXECUTED_SEARCH_RUN"
          }
        },
        "required": [
          "evidence_origin"
        ]
      },
      "then": {
        "required": [
          "search_execution_receipt"
        ],
        "properties": {
          "search_execution_receipt": {
            "type": "object"
          }
        }
      }
    }
  ]
}
