display2d:false$
load(kovacicODE)$
print("RESULT_c1_orig", kovacicODE((-2*x^3 + 2*x)*'diff(y,x,2)+(1 - 3*x^2)*'diff(y,x)+(0)*y=0, y, x))$
print("RESULT_c1_red", kovacicODE('diff(y,x,2)=((-3*x^4 - 6*x^2 - 3)/(16*x^6 - 32*x^4 + 16*x^2))*y, y, x))$
