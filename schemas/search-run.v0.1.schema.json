{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "miskatonic.search-run.v0.1",
  "title": "Miskatonic Search Run Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "problem_id",
    "search_policy",
    "policy_configuration",
    "metrics",
    "terminal_status",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "miskatonic.search-run.v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "search_policy": {
      "type": "string",
      "enum": [
        "DETERMINISTIC_FRONTIER",
        "BOUNDED_BEAM_SEARCH",
        "A_STAR",
        "MCTS",
        "EVOLUTIONARY",
        "NOVELTY_SEARCH",
        "LEARNED_HEURISTIC",
        "NEURAL_PREMISE_GUIDANCE",
        "RL",
        "HYBRID_LATENT"
      ]
    },
    "policy_configuration": {
      "type": "object"
    },
    "replay_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SYNTHETIC_REPLAY_FIXTURE",
        "EXECUTED_HELD_OUT_REPLAY",
        "EXECUTED_SEARCH_RUN",
        "CERTIFIED_SEARCH_REPLAY",
        null
      ]
    },
    "paired_replay_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "search_execution_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_trace_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_trace_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "corpus_guidance": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source_graph_ref": {
          "type": "string"
        },
        "retrieval_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_probabilities": {
          "type": "object"
        },
        "authority_disclaimer": {
          "const": "CORPUS_GUIDED_MCTS_DOES_NOT_CONFER_CORPUS_AUTHORITY"
        }
      }
    },
    "resulting_trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "required": [
        "nodes_expanded",
        "nodes_evaluated",
        "max_depth_reached",
        "total_wall_time_ms"
      ],
      "properties": {
        "nodes_expanded": {
          "type": "integer",
          "minimum": 0
        },
        "nodes_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth_reached": {
          "type": "integer",
          "minimum": 0
        },
        "branching_factor_effective": {
          "type": "number",
          "minimum": 0
        },
        "total_wall_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "backend_calls": {
          "type": "integer",
          "minimum": 0
        },
        "branch_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "terminal_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "EXHAUSTED",
        "TIMEOUT",
        "BUDGET_REACHED",
        "FAILED"
      ]
    },
    "authority": {
      "type": "string",
      "const": "NONE"
    }
  }
}
